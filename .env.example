# URL publique du frontend, intégrée au bundle au build
NEXT_PUBLIC_SITE_URL=

# Domaine partagé, routé vers NestJS sous /api par Dokploy; le code ajoute le préfixe.
NEXT_PUBLIC_BACKEND_API_URL=
# Alias historique, également publique
NEXT_PUBLIC_API_URL=

# URL interne du backend NestJS, utilisée par les routes serveur Next.js.
# Exemple : http://NOM_APP_BACKEND:3001 (DNS privé Dokploy, pas localhost); le code ajoute /api.
BACKEND_API_URL=

# Cookies administrateur et traces de développement
ADMIN_COOKIE_SECURE=true
AGENT_DEBUG=false
